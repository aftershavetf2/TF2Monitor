{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cargo",
      "command": "build",
      "problemMatcher": ["$rustc"],
      "group": "build",
      "label": "rust: cargo build"
    },
    {
      "label": "Release: Bump patch and publish",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": ["scripts/release.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
